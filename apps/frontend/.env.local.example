NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_BASE_URL=https://your-backend.railway.app

# Lichess personal access token with study:read scope (server-only, never NEXT_PUBLIC_).
# Optional in development. Create at https://lichess.org/account/oauth/token
LICHESS_API_TOKEN=
# WCC live transport: stream (default, browser streams from Lichess) | poll (via /api/wcc/round)
NEXT_PUBLIC_WCC_TRANSPORT=stream
